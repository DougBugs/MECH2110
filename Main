/*----------------------------------
  State Machine
----------------------------------*/
// State machine sequence variables
enum State {PICKUP, MOVE, DEPOSIT, RETURN, SUMMIT};
State state = DEPOSIT;

/*----------------------------------
  Starting Sequence
----------------------------------*/
// starting pins
const int button = 4;
const int led = 13;

//starting variables
unsigned long buttonTimeKeeper = 0; // needs to be an unsigned long cos milli is


/*----------------------------------
  RGB SENSOR
----------------------------------*/
#include <Wire.h>
#include "SparkFunISL29125.h"

SFE_ISL29125 RGB_sensor;

bool detectYellow() {
  uint16_t red = RGB_sensor.readRed();
  uint16_t green = RGB_sensor.readGreen();
  uint16_t blue = RGB_sensor.readBlue();
  
  // TreadRite yellow detection
  // High red, high green, low blue, and R/G roughly equal
  if (red > 0x7000 && green > 0x7000 && blue < 0x4000)
  {
    uint16_t diff = (red > green) ? (red - green) : (green - red);
    if (diff < 0x2000)
    {
      return true;
    }
  }
  return false;
}

/*----------------------------------
  IR sensor
----------------------------------*/
// we are running out of pins fml 
const int IRpin = 11;
const int IRLED = 12;


/*----------------------------------
  Motors
----------------------------------*/
const int BIN1 = 7;
const int BIN2 = 8;
const int PWMB = 10;
const int AIN1 = 5;
const int AIN2 = 6;
const int PWMA = 9;
int speed = 250;

void setSpeed(int speed) {
  analogWrite(PWMA, speed);
  analogWrite(PWMB, speed);
}

void noEnForward() {
  digitalWrite(AIN1, HIGH);
  digitalWrite(AIN2, LOW);
  digitalWrite(BIN1, LOW);
  digitalWrite(BIN2, HIGH);
}

void noEnBackward() {
  digitalWrite(AIN1, LOW);
  digitalWrite(AIN2, HIGH);
  digitalWrite(BIN1, HIGH);
  digitalWrite(BIN2, LOW);
}

void stopMotor() {
  digitalWrite(AIN1, LOW);
  digitalWrite(AIN2, LOW);
  digitalWrite(BIN1, LOW);
  digitalWrite(BIN2, LOW);
}

void brakeMotor() {
  digitalWrite(AIN1, HIGH);
  digitalWrite(AIN2, HIGH);
  digitalWrite(BIN1, HIGH);
  digitalWrite(BIN2, HIGH);
}

/*----------------------------------
  Encoders
----------------------------------*/
const int ENA = 2;
const int ENB = 3;
volatile int pulsesA = 0;
volatile int pulsesB = 0;

void countPulseA() {
  pulsesA++;
}
void countPulseB() {
  pulsesB++;
}
/*----------------------------------
  Driving logic
----------------------------------*/
const int wheelDiameter = 65; // this is in mm
const int ticksRev = 20; // Amount of slots in the encoder wheel for one revolution
const int wheelBase = 180; // This is the distance between the weels(MEASURE THIS PROPERLY AS ITS A GUESS)
const float mmPerTick = (PI * wheelDiameter) / ticksRev;
const int turnSpeed = 180;

// below are some variables for moving towards ramp
bool startMove = false;
bool yellow = false;

// below are some variabels for going up the ramp
const int rampTarget = 250; // tune this so that we have the correct speed for the ramp
bool startRamp = false;

// Resets pulses and sets to forward. use this before going forward
void forward() {
  pulsesA = 0;
  pulsesB = 0;
  noEnForward();
}

int speedA = speed;
int speedB = speed;

void updateForward() {
  if (pulsesA > pulsesB + 1) {
    speedA = max(speedA - 1, 0);
  } else if (pulsesB > pulsesA + 1) {
    speedB = max(speedB - 1, 0);
  } else {
    speedA = min(speedA + 1, speed);
    speedB = min(speedB + 1, speed);
  }
  analogWrite(PWMA, speedA);
  analogWrite(PWMB, speedB);
}

void turn180() {
  pulsesA = 0;
  pulsesB = 0;
  int targetTicks = ((180 / 360.0) * PI * wheelBase) / mmPerTick;
  setSpeed(turnSpeed);
  digitalWrite(AIN1, HIGH);
  digitalWrite(AIN2, LOW);
  digitalWrite(BIN1, HIGH);
  digitalWrite(BIN2, LOW);

  while (pulsesA < targetTicks && pulsesB < targetTicks);

  brakeMotor();
  setSpeed(speed);
}

void turn90() {
  pulsesA = 0;
  pulsesB = 0;
  int targetTicks = ((90 / 360.0) * PI * wheelBase) / mmPerTick;
  setSpeed(turnSpeed);
  digitalWrite(AIN1, HIGH);
  digitalWrite(AIN2, LOW);
  digitalWrite(BIN1, HIGH);
  digitalWrite(BIN2, LOW);

  while (pulsesA < targetTicks && pulsesB < targetTicks);

  brakeMotor();
  setSpeed(speed);
}

void rampUp() {
  int rampSpeed = 0;
  while (pulsesA == 0 && pulsesB == 0) {
    rampSpeed++;
    setSpeed(rampSpeed);
    delay(10);
  }
  while (rampSpeed < rampTarget) {
    rampSpeed++;
    setSpeed(rampSpeed);
    delay(10);
  }
  speed = rampSpeed;
}

/*----------------------------------
  Setup
----------------------------------*/
void setup() {
  // put your setup code here, to run once:
  Serial.begin(9600);
  // Motors
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);
  setSpeed(speed);
  // Encoders
  pinMode(ENA, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENA), countPulseA, RISING);
  pinMode(ENB, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENB), countPulseB, RISING);
  //LED and Button
  pinMode(led, OUTPUT); // LED Output
  pinMode(button, INPUT_PULLUP); // Button
  // IR setup
  pinMode(IRpin, INPUT);
  pinMode(IRLED, OUTPUT);
  // RGB Setup
  if (!RGB_sensor.init())
  {
    Serial.println("RGB Sensor init failed!");
    while(1);
  }
  // Wait for button press and instantly move on when pressed
  while (digitalRead(button) == HIGH) {  
    if (millis() > buttonTimeKeeper) {
      digitalWrite(led, !digitalRead(led));
      buttonTimeKeeper = millis() + 300; 
    }
  }
  digitalWrite(led, LOW);
}



void loop() {
  switch (state) {
    case PICKUP:

      // motor control for picking up arm here

      break;

    case MOVE:
      // moving to the ramp here
      
      if (startMove == false) {
        forward();
        startMove = true;
      }

      // while there is no yellow detected keep moving forward
      while (!yellow) {
        updateForward();
        if (detectYellow()) {  // NOW IT DETECTS YELLOW!
          yellow = true;
        }
      }

      // Code to turn right
      if (yellow) {
        turn90();
        state = SUMMIT;
      }
      break;
    case SUMMIT:
      // do this when first summiting ramp
      if (startRamp == false) {  
        // set to forward and reset pulse counts
        forward();
        // slowly increment speed to target ramp speed
        rampUp();
      }
      // DETECT THE RAMP HOLE HERE BRAKE MOTORS ONCE DETECTED AND SWITCH STATE TO DEPOSIT
      break;
    case DEPOSIT:
      //depositing code here :)
      noEnForward();
      Serial.println(pulsesA);
      Serial.println(pulsesB);
      break;
    case RETURN:
      //Returning code here :)

      break;      
  }
}
